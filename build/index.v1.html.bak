,[10.02,50.982],[10.043,51.015],[10.204,51.003],[10.203,51.044],[10.15,51.055],[10.179,51.118],[10.125,51.141],[10.172,51.151],[10.214,51.118],[10.237,51.181],[10.076,51.226],[10.057,51.278],[9.974,51.286],[9.925,51.372],[10.055,51.438],[10.162,51.43],[10.144,51.441],[10.196,51.482],[10.303,51.492],[10.368,51.537],[10.378,51.585],[10.659,51.553],[10.64,51.619],[10.772,51.645]]]}];

/* ══════════════ Konfiguration ═══════════════════════════════════════════════ */
const BB   = {lat0:47.10, lat1:55.20, lon0:5.60, lon1:15.40};
const KX   = Math.cos(51.2*Math.PI/180);
const GRID = {lat0:47.25, lat1:55.05, lon0:5.90, lon1:15.10, rows:13, cols:11};
const HOURS = 49;                       // 0 … 48 h
const LEVELS = [
  {t:70, c:'#d92f86', n:'Extrem'},
  {t:45, c:'#ee7a12', n:'Hoch'},
  {t:25, c:'#f2d84b', n:'Erhöht'},
  {t:10, c:'#57b6e0', n:'Gering'},
  {t:-1, c:'#7f93a6', n:'Minimal'}
];
const LAY = {risk:true, wind:true, cells:true, scan:true};

const NC = GRID.rows*GRID.cols;
const dLat = (GRID.lat1-GRID.lat0)/(GRID.rows-1);
const dLon = (GRID.lon1-GRID.lon0)/(GRID.cols-1);

/* Daten: D.tpi[h] = Float32Array(NC), analog cape/shear/cin/lcl/u/v */
const D = {tpi:[], cape:[], shear:[], cin:[], lcl:[], u:[], v:[], t0:null, run:'–'};

/* ══════════════ Canvas & Projektion ═════════════════════════════════════════ */
const stage = document.getElementById('stage');
const cBase = document.getElementById('base'), xB = cBase.getContext('2d');
const cWind = document.getElementById('wind'), xW = cWind.getContext('2d');
const cFx   = document.getElementById('fx'),   xF = cFx.getContext('2d');
let W=0, H=0, DPR=1, SC=1, OX=0, OY=0, dePath=null;
const X0 = BB.lon0*KX;

function project(lon,lat){ return [OX+(lon*KX-X0)*SC, OY+(BB.lat1-lat)*SC]; }
function unproject(px,py){ return [((px-OX)/SC+X0)/KX, BB.lat1-(py-OY)/SC]; }

function resize(){
  DPR = Math.min(window.devicePixelRatio||1, 2);
  W = stage.clientWidth; H = stage.clientHeight;
  for(const c of [cBase,cWind,cFx]){ c.width = W*DPR; c.height = H*DPR; }
  for(const x of [xB,xW,xF]){ x.setTransform(DPR,0,0,DPR,0,0); }

  const pad = Math.min(W,H)*0.055;
  const gw = (BB.lon1-BB.lon0)*KX, gh = BB.lat1-BB.lat0;
  SC = Math.min((W-2*pad)/gw, (H-2*pad)/gh);
  OX = (W-gw*SC)/2; OY = (H-gh*SC)/2;

  dePath = new Path2D();
  for(const s of DE) for(const r of s.r){
    dePath.moveTo(...project(r[0][0], r[0][1]));
    for(let i=1;i<r.length;i++) dePath.lineTo(...project(r[i][0], r[i][1]));
    dePath.closePath();
  }
  seedParticles();
  drawBase();
}
window.addEventListener('resize', resize);

/* ══════════════ Feld-Interpolation ══════════════════════════════════════════ */
function bilinear(arr, lon, lat){
  if(!arr) return 0;
  const fx = (lon-GRID.lon0)/dLon, fy = (GRID.lat1-lat)/dLat;
  const cx = Math.max(0, Math.min(GRID.cols-1.001, fx));
  const cy = Math.max(0, Math.min(GRID.rows-1.001, fy));
  const i0 = Math.floor(cx), j0 = Math.floor(cy);
  const i1 = Math.min(i0+1, GRID.cols-1), j1 = Math.min(j0+1, GRID.rows-1);
  const tx = cx-i0, ty = cy-j0;
  const a = arr[j0*GRID.cols+i0], b = arr[j0*GRID.cols+i1];
  const c = arr[j1*GRID.cols+i0], d = arr[j1*GRID.cols+i1];
  return (a*(1-tx)+b*tx)*(1-ty) + (c*(1-tx)+d*tx)*ty;
}
/* Zeitlich interpolierter Zugriff (t darf gebrochen sein) */
let T = 0;
function fieldAt(key, lon, lat, t=T){
  const s = D[key]; if(!s.length) return 0;
  const i = Math.max(0, Math.min(s.length-1, Math.floor(t)));
  const j = Math.min(s.length-1, i+1), f = t-i;
  return bilinear(s[i],lon,lat)*(1-f) + bilinear(s[j],lon,lat)*f;
}
function cellAt(key, idx, t=T){
  const s = D[key]; if(!s.length) return 0;
  const i = Math.max(0, Math.min(s.length-1, Math.floor(t)));
  const j = Math.min(s.length-1, i+1), f = t-i;
  return s[i][idx]*(1-f) + s[j][idx]*f;
}

/* ══════════════ Farbe ═══════════════════════════════════════════════════════ */
const RAMP = [[0,'#0e2033',0],[10,'#57b6e0',.30],[25,'#f2d84b',.46],
              [45,'#ee7a12',.60],[70,'#d92f86',.74],[100,'#ff9ad8',.84]];
function hex2rgb(h){return [parseInt(h.slice(1,3),16),parseInt(h.slice(3,5),16),parseInt(h.slice(5,7),16)];}
const RAMPRGB = RAMP.map(s=>[s[0], hex2rgb(s[1]), s[2]]);
function rampColor(v){
  if(v<=6) return [0,0,0,0];
  for(let i=1;i<RAMPRGB.length;i++){
    if(v<=RAMPRGB[i][0] || i===RAMPRGB.length-1){
      const A=RAMPRGB[i-1], B=RAMPRGB[i];
      const f=Math.max(0,Math.min(1,(v-A[0])/(B[0]-A[0])));
      const fade = v<12 ? (v-6)/6 : 1;
      return [A[1][0]+(B[1][0]-A[1][0])*f, A[1][1]+(B[1][1]-A[1][1])*f,
              A[1][2]+(B[1][2]-A[1][2])*f, (A[2]+(B[2]-A[2])*f)*fade];
    }
  }
  return [0,0,0,0];
}
function levelOf(v){ for(const L of LEVELS) if(v>=L.t) return L; return LEVELS[LEVELS.length-1]; }

/* ══════════════ Basis-Layer: Hintergrundgitter, Risikofeld, Grenzen ═════════ */
const fieldCv = document.createElement('canvas');
const fieldCx = fieldCv.getContext('2d');
const SUP = 6;                                   // Übersampling für weiche Blobs
fieldCv.width = (GRID.cols-1)*SUP+1; fieldCv.height = (GRID.rows-1)*SUP+1;

function paintField(){
  const w=fieldCv.width, h=fieldCv.height;
  const img = fieldCx.createImageData(w,h);
  for(let y=0;y<h;y++){
    const lat = GRID.lat1 - (y/(h-1))*(GRID.lat1-GRID.lat0);
    for(let x=0;x<w;x++){
      const lon = GRID.lon0 + (x/(w-1))*(GRID.lon1-GRID.lon0);
      const [r,g,b,a] = rampColor(fieldAt('tpi',lon,lat));
      const o=(y*w+x)*4;
      img.data[o]=r; img.data[o+1]=g; img.data[o+2]=b; img.data[o+3]=a*255;
    }
  }
  fieldCx.putImageData(img,0,0);
}

function drawBase(){
  xB.clearRect(0,0,W,H);

  /* Längen-/Breitengradnetz */
  xB.save(); xB.strokeStyle='rgba(120,190,230,.055)'; xB.lineWidth=1;
  for(let lat=48;lat<=55;lat++){ const [,y]=project(10,lat);
    xB.beginPath(); xB.moveTo(0,y); xB.lineTo(W,y); xB.stroke(); }
  for(let lon=6;lon<=15;lon++){ const [x]=project(lon,51);
    xB.beginPath(); xB.moveTo(x,0); xB.lineTo(x,H); xB.stroke(); }
  xB.restore();

  /* Grundfläche Deutschland */
  xB.save();
  xB.fillStyle='rgba(16,32,52,.55)'; xB.fill(dePath,'evenodd');
  xB.restore();

  /* Risikofeld, auf die Landesfläche geclippt */
  if(LAY.risk && D.tpi.length){
    paintField();
    xB.save(); xB.clip(dePath,'evenodd');
    xB.globalCompositeOperation='lighter';
    xB.imageSmoothingEnabled=true; xB.imageSmoothingQuality='high';
    const [px0,py0]=project(GRID.lon0,GRID.lat1), [px1,py1]=project(GRID.lon1,GRID.lat0);
    xB.drawImage(fieldCv, px0,py0, px1-px0, py1-py0);
    xB.restore();
  }

  /* Grenzen: weicher Schein + scharfe Linie */
  xB.save();
  xB.strokeStyle='rgba(87,182,224,.30)'; xB.lineWidth=1;
  xB.stroke(dePath);
  xB.shadowColor='rgba(87,182,224,.85)'; xB.shadowBlur=16;
  xB.strokeStyle='rgba(150,215,245,.75)'; xB.lineWidth=1.3;
  xB.stroke(dePath);
  xB.restore();
}

/* ══════════════ Wind-Partikel ═══════════════════════════════════════════════ */
let P = [], NP = 0;
function seedParticles(){
  NP = Math.round(Math.min(4200, Math.max(900, (W*H)/430)));
  P = new Array(NP);
  for(let i=0;i<NP;i++) P[i] = spawn({});
}
function spawn(p){
  p.x = Math.random()*W; p.y = Math.random()*H;
  p.age = Math.random()*90|0; p.max = 55 + Math.random()*95|0;
  return p;
}
function drawWind(){
  if(!LAY.wind || !D.u.length){ xW.clearRect(0,0,W,H); return; }
  /* Alpha-Fade statt Übermalen — der Layer bleibt transparent */
  xW.globalCompositeOperation='destination-out';
  xW.fillStyle='rgba(0,0,0,0.10)'; xW.fillRect(0,0,W,H);
  xW.globalCompositeOperation='source-over';
  xW.lineWidth=1.05; xW.lineCap='round';

  const k = 0.038*SC/9;                       // Bewegung px pro Frame je m/s
  for(let i=0;i<NP;i++){
    const p=P[i];
    if(p.age++ > p.max || p.x<-40||p.x>W+40||p.y<-40||p.y>H+40){ spawn(p); continue; }
    const [lon,lat]=unproject(p.x,p.y);
    const u=fieldAt('u',lon,lat), v=fieldAt('v',lon,lat);
    const nx = p.x + u*k, ny = p.y - v*k;
    const sp = Math.hypot(u,v);
    const a = Math.min(.62, .13 + sp/58);
    xW.strokeStyle = sp>26 ? `rgba(190,232,255,${a})`
                   : sp>15 ? `rgba(120,196,236,${a})`
                           : `rgba(78,150,196,${a*0.85})`;
    xW.beginPath(); xW.moveTo(p.x,p.y); xW.lineTo(nx,ny); xW.stroke();
    p.x=nx; p.y=ny;
  }
}

/* ══════════════ FX-Layer: Abdunklung außen, Hotspots, Scan, Cursor ═════════ */
let hover=null, hotspots=[], scanT=0;

function findHotspots(){
  hotspots=[];
  if(!D.tpi.length) return;
  for(let j=0;j<GRID.rows;j++) for(let i=0;i<GRID.cols;i++){
    const idx=j*GRID.cols+i, v=cellAt('tpi',idx);
    if(v<28) continue;
    let isMax=true;
    for(let dj=-1;dj<=1&&isMax;dj++) for(let di=-1;di<=1;di++){
      if(!di&&!dj) continue;
      const nj=j+dj, ni=i+di;
      if(nj<0||nj>=GRID.rows||ni<0||ni>=GRID.cols) continue;
      if(cellAt('tpi',nj*GRID.cols+ni) > v){ isMax=false; break; }
    }
    if(!isMax) continue;
    const lat=GRID.lat1-j*dLat, lon=GRID.lon0+i*dLon;
    if(!inDE(lon,lat)) continue;
    hotspots.push({lon,lat,v});
  }
  /* Auf Plateaus (z. B. gedeckelter Index) liegen mehrere Maxima nebeneinander —
     Mindestabstand erzwingen, sonst überlagern sich die Marker und ihre Labels. */
  hotspots.sort((a,b)=>b.v-a.v);
  const keep=[];
  for(const h of hotspots){
    if(keep.every(k=>Math.hypot((k.lon-h.lon)/dLon,(k.lat-h.lat)/dLat) >= 2.2)) keep.push(h);
    if(keep.length===4) break;
  }
  hotspots=keep;
}
function inDE(lon,lat){
  /* Punkt in Nutzer-Koordinaten — die CTM wird von isPointInPath selbst angewandt */
  const [x,y]=project(lon,lat);
  return xF.isPointInPath(dePath, x, y, 'evenodd');
}

function drawFx(ts){
  xF.clearRect(0,0,W,H);

  /* Alles außerhalb Deutschlands abdunkeln (Rechteck + Land, evenodd = Loch) */
  const mask=new Path2D(); mask.rect(0,0,W,H); mask.addPath(dePath);
  xF.save(); xF.fillStyle='rgba(4,7,14,.62)'; xF.fill(mask,'evenodd'); xF.restore();

  /* Scan-Sweep */
  if(LAY.scan){
    scanT=(ts/9000)%1.35;
    if(scanT<1){
      const y=scanT*H;
      const g=xF.createLinearGradient(0,y-70,0,y+8);
      g.addColorStop(0,'rgba(87,182,224,0)'); g.addColorStop(1,'rgba(87,182,224,.11)');
      xF.save(); xF.clip(dePath,'evenodd');
      xF.fillStyle=g; xF.fillRect(0,y-70,W,78);
      xF.strokeStyle='rgba(150,220,255,.35)'; xF.lineWidth=1;
      xF.beginPath(); xF.moveTo(0,y); xF.lineTo(W,y); xF.stroke();
      xF.restore();
    }
  }

  /* Hotspots mit pulsierenden Ringen */
  if(LAY.cells){
    for(let n=0;n<hotspots.length;n++){
      const hs=hotspots[n], [x,y]=project(hs.lon,hs.lat), L=levelOf(hs.v);
      for(let r=0;r<3;r++){
        const ph=((ts/1650)+r/3+n*0.17)%1;
        xF.beginPath(); xF.arc(x,y, 9+ph*40, 0, 6.2832);
        xF.strokeStyle=L.c; xF.globalAlpha=(1-ph)*0.42; xF.lineWidth=1.4; xF.stroke();
      }
      xF.globalAlpha=1;
      xF.beginPath(); xF.arc(x,y,3.6,0,6.2832);
      xF.fillStyle=L.c; xF.shadowColor=L.c; xF.shadowBlur=14; xF.fill(); xF.shadowBlur=0;

      if(n<3){
        const left = x > W*0.72;                       // am rechten Rand nach links setzen
        const d = left ? -1 : 1;
        xF.font='600 10px ui-monospace,Menlo,monospace';
        xF.fillStyle='rgba(232,241,248,.9)';
        xF.textAlign = left ? 'right' : 'left';
        xF.fillText(`TPI ${Math.round(hs.v)}`, x+13*d, y+3.5);
        xF.strokeStyle='rgba(232,241,248,.28)'; xF.lineWidth=1;
        xF.beginPath(); xF.moveTo(x+6*d,y); xF.lineTo(x+11*d,y); xF.stroke();
      }
    }
  }

  /* Cursor-Fadenkreuz */
  if(hover){
    const {x,y}=hover;
    xF.save(); xF.strokeStyle='rgba(87,182,224,.32)'; xF.setLineDash([4,5]); xF.lineWidth=1;
    xF.beginPath(); xF.moveTo(x,0); xF.lineTo(x,H); xF.moveTo(0,y); xF.lineTo(W,y); xF.stroke();
    xF.setLineDash([]);
    xF.beginPath(); xF.arc(x,y,15,0,6.2832); xF.strokeStyle='rgba(150,220,255,.6)'; xF.stroke();
    xF.beginPath(); xF.arc(x,y,2,0,6.2832); xF.fillStyle='#eaf6ff'; xF.fill();
    xF.restore();
  }
}

/* ══════════════ Panel ═══════════════════════════════════════════════════════ */
function updatePanel(){
  let lon,lat,title,pos='';
  if(hover){
    [lon,lat]=unproject(hover.x,hover.y);
    title='Position unter Cursor';
    pos=`${lat.toFixed(2)}°N ${lon.toFixed(2)}°E`;
  }else{
    const hs=hotspots[0];
    if(hs){ lon=hs.lon; lat=hs.lat; } else { lon=10.4; lat=51.2; }
    title = hs ? 'Deutschlandweites Maximum' : 'Bezugspunkt Mitte';
  }
  const tpi=fieldAt('tpi',lon,lat), L=levelOf(tpi);
  const set=(id,v)=>document.getElementById(id).textContent=v;
  set('pTitle',title); set('pPos',pos);
  set('pTpi', D.tpi.length ? Math.round(tpi) : '–');
  set('pCape', Math.round(fieldAt('cape',lon,lat)));
  set('pShear', fieldAt('shear',lon,lat).toFixed(1));
  set('pCin', Math.round(fieldAt('cin',lon,lat)));
  set('pLcl', Math.round(fieldAt('lcl',lon,lat)));
  set('pWind', Math.round(Math.hypot(fieldAt('u',lon,lat),fieldAt('v',lon,lat))*3.6));

  const chip=document.getElementById('pChip');
  chip.style.color=L.c; chip.style.borderColor=L.c+'66'; chip.style.background=L.c+'1a';
  chip.querySelector('i').style.background=L.c;
  chip.querySelector('span').textContent=L.n+' — Tornado-Potenzial';
  const bar=document.getElementById('pBar');
  bar.style.width=Math.min(100,tpi)+'%'; bar.style.background=L.c;
}

/* ══════════════ Zeitleiste ══════════════════════════════════════════════════ */
const slider=document.getElementById('slider');
function buildTicks(){
  const el=document.getElementById('ticks'); el.innerHTML='';
  if(!D.t0) return;
  for(let h=0;h<=48;h+=6){
    const d=new Date(D.t0.getTime()+h*3600e3);
    const u=document.createElement('u');
    u.style.left=(h/48*100)+'%';
    /* Rand-Marken nicht über den Slider hinausschieben */
    if(h===0)  u.style.transform='translateX(0)';
    if(h===48) u.style.transform='translateX(-100%)';
    u.textContent = h===0 ? 'JETZT' : d.toLocaleTimeString('de-DE',{hour:'2-digit',minute:'2-digit'});
    el.appendChild(u);
  }
}
function updateTime(){
  if(!D.t0) return;
  const d=new Date(D.t0.getTime()+T*3600e3);
  document.getElementById('tLabel').textContent =
    d.toLocaleString('de-DE',{weekday:'short',day:'2-digit',month:'2-digit',
                              hour:'2-digit',minute:'2-digit'})+' Uhr';
  const h=Math.round(T);
  document.getElementById('tRel').textContent = h===0 ? 'Jetzt' : `+${h} Stunden`;
}
slider.addEventListener('input',()=>{ T=parseFloat(slider.value); playing=false;
  document.getElementById('play').textContent='▶'; onTimeChange(); });

let playing=false;
document.getElementById('play').addEventListener('click',function(){
  playing=!playing; this.textContent = playing?'❚❚':'▶';
});

let lastT=-1;
function onTimeChange(){
  paintFieldDirty=true; findHotspots(); updateTime(); updatePanel();
}

/* ══════════════ Layer-Schalter ══════════════════════════════════════════════ */
document.querySelectorAll('.tgl').forEach(el=>{
  el.addEventListener('click',()=>{
    const k=el.dataset.l; LAY[k]=!LAY[k]; el.classList.toggle('on',LAY[k]);
    if(k==='wind' && !LAY.wind) xW.clearRect(0,0,W,H);
    if(k==='risk') paintFieldDirty=true;
  });
});

/* ══════════════ Maus ════════════════════════════════════════════════════════ */
cFx.addEventListener('mousemove',e=>{
  const r=cFx.getBoundingClientRect();
  hover={x:e.clientX-r.left, y:e.clientY-r.top}; updatePanel();
});
cFx.addEventListener('mouseleave',()=>{ hover=null; updatePanel(); });

/* ══════════════ Render-Schleife ═════════════════════════════════════════════ */
let paintFieldDirty=true;
function loop(ts){
  if(playing){
    T += 0.045;
    if(T>48) T=0;
    slider.value=T;
    if(Math.floor(T*4)!==Math.floor(lastT*4)){ onTimeChange(); lastT=T; }
  }
  if(paintFieldDirty){ drawBase(); paintFieldDirty=false; }
  drawWind();
  drawFx(ts);
  requestAnimationFrame(loop);
}

/* ══════════════ Index-Berechnung ════════════════════════════════════════════ */
function tpiOf(cape, shear, cin, lcl){
  const capeTerm  = Math.min(1.45, Math.sqrt(Math.max(cape,0)/1500));
  const shearTerm = Math.max(0, Math.min(1.25, (shear-8)/17));
  const cinTerm   = Math.max(0.15, Math.min(1, 1-(Math.abs(Math.min(cin,0))-50)/200));
  const lclTerm   = Math.max(0.25, Math.min(1.1, 1.2-lcl/2000));
  return Math.min(100, 100*capeTerm*shearTerm*cinTerm*lclTerm);
}
/* meteorologische Richtung (woher) → u/v in m/s */
function uv(spdKmh, dirDeg){
  const s=spdKmh/3.6, r=dirDeg*Math.PI/180;
  return [-s*Math.sin(r), -s*Math.cos(r)];
}

/* ══════════════ Boot-Log ════════════════════════════════════════════════════ */
const logEl=document.getElementById('bootlog'), barEl=document.getElementById('bootbar');
let bootStep=0;
function blog(msg, pct){
  const d=document.createElement('div'); d.textContent=msg; logEl.appendChild(d);
  barEl.style.width=pct+'%';
}

/* ══════════════ Daten laden ═════════════════════════════════════════════════ */
async function load(){
  blog('Initialisiere Projektion und Landesgeometrie …', 12);
  const lats=[], lons=[];
  for(let j=0;j<GRID.rows;j++) for(let i=0;i<GRID.cols;i++){
    lats.push((GRID.lat1-j*dLat).toFixed(2));
    lons.push((GRID.lon0+i*dLon).toFixed(2));
  }
  document.getElementById('sGrid').textContent = `${GRID.cols}×${GRID.rows} · ${NC} Pkt`;
  blog(`Gitter aufgespannt — ${NC} Stützstellen über Deutschland`, 28);

  const url='https://api.open-meteo.com/v1/forecast'
    +'?latitude='+lats.join(',')+'&longitude='+lons.join(',')
    +'&hourly=cape,convective_inhibition,wind_speed_10m,wind_direction_10m,'
    +'wind_speed_500hPa,wind_direction_500hPa,temperature_2m,dew_point_2m'
    +'&forecast_days=3&timezone=UTC';

  /* ?demo=1 → synthetische Unwetterlage, um das Layout bei hohen Werten zu zeigen */
  if(new URLSearchParams(location.search).get('demo')==='1'){
    blog('DEMO-MODUS — synthetische Superzellenlage', 70);
    document.getElementById('sLed').outerHTML =
      '<span class="led warn" id="sLed"><i></i>DEMO-LAGE</span>';
    document.getElementById('sModel').textContent='Synthetisch';
    synth(); finish(); return;
  }

  blog('Frage Modelldaten ab (Open-Meteo / DWD ICON) …', 44);
  let raw=null;
  try{
    const res=await fetch(url);
    if(!res.ok) throw new Error('HTTP '+res.status);
    raw=await res.json();
    if(!Array.isArray(raw)) raw=[raw];
    if(raw.length!==NC) throw new Error('Punktzahl '+raw.length);
  }catch(err){
    blog('⚠ Keine Verbindung ('+err.message+') — Demo-Modus mit synthetischem Feld', 70);
    document.getElementById('sLed').outerHTML =
      '<span class="led warn" id="sLed"><i></i>DEMO-MODUS</span>';
    document.getElementById('sModel').textContent='Synthetisch';
    synth(); finish(); return;
  }

  blog('Verarbeite Vertikalprofile, berechne Scherung und LCL …', 66);

  /* Zeitachse: nächste volle Stunde ab jetzt */
  const times = raw[0].hourly.time;
  const now = Date.now();
  let start = times.findIndex(t => new Date(t+'Z').getTime() >= now - 3600e3);
  if(start<0) start=0;
  start = Math.min(start, Math.max(0, times.length-HOURS));
  D.t0 = new Date(times[start]+'Z');
  D.run = new Date(times[0]+'Z').toLocaleString('de-DE',
            {day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'});

  const n = Math.min(HOURS, times.length-start);
  for(let h=0;h<n;h++){
    const tpi=new Float32Array(NC), cape=new Float32Array(NC), shear=new Float32Array(NC);
    const cin=new Float32Array(NC), lcl=new Float32Array(NC);
    const u=new Float32Array(NC), v=new Float32Array(NC);
    for(let c=0;c<NC;c++){
      const H_=raw[c].hourly, k=start+h;
      const cp = H_.cape[k] ?? 0;
      const ci = H_.convective_inhibition[k] ?? 0;
      const [u10,v10] = uv(H_.wind_speed_10m[k]??0, H_.wind_direction_10m[k]??0);
      const [u50,v50] = uv(H_.wind_speed_500hPa[k]??0, H_.wind_direction_500hPa[k]??0);
      const sh = Math.hypot(u50-u10, v50-v10);          // Tiefenscherung ≈ 0–6 km
      const t2 = H_.temperature_2m[k] ?? 15, td = H_.dew_point_2m[k] ?? 10;
      const lz = Math.max(50, 125*(t2-td));             // LCL-Höhe in m
      cape[c]=cp; cin[c]=ci; shear[c]=sh; lcl[c]=lz; u[c]=u50; v[c]=v50;
      tpi[c]=tpiOf(cp, sh, ci, lz);
    }
    D.tpi.push(tpi); D.cape.push(cape); D.shear.push(shear);
    D.cin.push(cin); D.lcl.push(lcl); D.u.push(u); D.v.push(v);
  }
  document.getElementById('sRun').textContent=D.run+' UTC';
  document.getElementById('sLed').outerHTML =
    '<span class="led" id="sLed"><i></i>DATEN AKTIV</span>';
  blog(`${n} Vorhersagestunden aufbereitet · Index berechnet`, 90);
  finish();
}

/* Synthetisches Feld, damit der Prototyp auch offline etwas zeigt */
function synth(){
  D.t0=new Date(Math.ceil(Date.now()/3600e3)*3600e3);
  document.getElementById('sRun').textContent='—';
  for(let h=0;h<HOURS;h++){
    const tpi=new Float32Array(NC),cape=new Float32Array(NC),shear=new Float32Array(NC);
    const cin=new Float32Array(NC),lcl=new Float32Array(NC);
    const u=new Float32Array(NC),v=new Float32Array(NC);
    const px=0.35+h*0.06, py=0.9-h*0.012;
    for(let j=0;j<GRID.rows;j++) for(let i=0;i<GRID.cols;i++){
      const c=j*GRID.cols+i, fx=i/(GRID.cols-1), fy=j/(GRID.rows-1);
      const d=Math.hypot(fx-(px%1.4-0.2), fy-py);
      const blob=Math.exp(-d*d*9);
      const cp=200+2600*blob*(0.6+0.4*Math.sin(h/3.4+i*0.4));
      const sh=9+22*blob+4*Math.sin(h/5+j*0.5);
      cape[c]=cp; shear[c]=sh; cin[c]=-20-60*(1-blob); lcl[c]=1500-800*blob;
      const dir=200+60*fy+18*Math.sin(h/6+fx*3);
      const spd=35+70*blob+25*fy;
      const w=uv(spd,dir); u[c]=w[0]; v[c]=w[1];
      tpi[c]=tpiOf(cp,sh,cin[c],lcl[c]);
    }
    D.tpi.push(tpi);D.cape.push(cape);D.shear.push(shear);
    D.cin.push(cin);D.lcl.push(lcl);D.u.push(u);D.v.push(v);
  }
}

/* Höchstwert der nächsten 48 h — löst das „leere Karte"-Problem:
   auch an ruhigen Tagen sieht man sofort, wann überhaupt etwas los ist. */
function buildPeak(){
  const el=document.getElementById('peak');
  let best={v:-1,h:0};
  for(let h=0;h<D.tpi.length;h++){
    const a=D.tpi[h];
    for(let c=0;c<NC;c++) if(a[c]>best.v) best={v:a[c],h};
  }
  const L=levelOf(best.v);
  const d=new Date(D.t0.getTime()+best.h*3600e3);
  const when = best.h===0 ? 'jetzt'
    : d.toLocaleString('de-DE',{weekday:'short',hour:'2-digit',minute:'2-digit'})+' Uhr';
  el.hidden=false;
  el.innerHTML = best.v<10
    ? `<i style="background:${L.c}"></i>Ruhige Lage — kein nennenswertes Konvektionspotenzial in 48 h`
      + `<s>Höchstwert TPI ${Math.round(best.v)}</s>`
    : `<i style="background:${L.c}"></i>Höchstes Potenzial: <b style="color:${L.c}">`
      + `${L.n} · TPI ${Math.round(best.v)}</b> um ${when}<s>anspringen ›</s>`;
  el.onclick=()=>{ T=best.h; slider.value=T; playing=false;
    document.getElementById('play').textContent='▶'; onTimeChange(); };
}

function finish(){
  buildTicks(); buildPeak(); resize();
  const qt=parseFloat(new URLSearchParams(location.search).get('t'));
  if(!isNaN(qt)){ T=Math.max(0,Math.min(48,qt)); slider.value=T; }
  onTimeChange();
  blog('Bereit.', 100);
  const boot=document.getElementById('boot');
  if(new URLSearchParams(location.search).has('noboot')) boot.remove();
  else setTimeout(()=>{ boot.classList.add('gone');
                        setTimeout(()=>boot.remove(), 900); }, 520);
  requestAnimationFrame(loop);
}

blog('Systemstart …', 4);
setTimeout(load, 260);
</script>
</body>
</html>
