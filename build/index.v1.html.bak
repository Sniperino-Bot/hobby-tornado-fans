<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>TORNADO//DE — Konvektions-Potenzial Deutschland</title>
<style>
:root{
  --bg:#05070d; --bg2:#080d16; --ink:#e8f1f8; --ink2:#8fa6b8; --ink3:#5b7086;
  --line:rgba(120,190,230,.18); --glass:rgba(10,18,30,.72);
  --l1:#57b6e0; --l2:#f2d84b; --l3:#ee7a12; --l4:#d92f86;
  --accent:#57b6e0;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{
  background:var(--bg); color:var(--ink); overflow:hidden;
  font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  -webkit-font-smoothing:antialiased;
}
.mono{font-family:ui-monospace,"SF Mono",Menlo,Consolas,monospace;font-variant-numeric:tabular-nums}

/* ---------- Rahmen / Layout ---------- */
#app{position:fixed;inset:0;display:grid;grid-template-rows:auto 1fr auto}
#stage{position:relative;overflow:hidden;background:
  radial-gradient(120% 90% at 50% 10%, #0b1526 0%, #05070d 62%, #03050a 100%)}
canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
#fx{cursor:crosshair}

/* ---------- Kopf ---------- */
header{
  display:flex;align-items:center;gap:18px;padding:12px 20px;
  border-bottom:1px solid var(--line);
  background:linear-gradient(180deg,rgba(10,20,34,.9),rgba(5,7,13,.6));
  backdrop-filter:blur(8px);position:relative;z-index:5;
}
header:after{content:"";position:absolute;left:0;right:0;bottom:-1px;height:1px;
  background:linear-gradient(90deg,transparent,var(--accent),transparent);opacity:.5}
.brand{display:flex;align-items:baseline;gap:10px}
.brand b{font-size:17px;letter-spacing:.16em;font-weight:700}
.brand b i{font-style:normal;color:var(--accent)}
.brand span{font-size:11px;color:var(--ink3);letter-spacing:.13em;text-transform:uppercase}
.spacer{flex:1}
.stat{display:flex;flex-direction:column;gap:2px;padding:0 14px;border-left:1px solid var(--line)}
.stat u{text-decoration:none;font-size:9.5px;letter-spacing:.14em;color:var(--ink3);text-transform:uppercase}
.stat b{font-size:13px;font-weight:600;letter-spacing:.02em}
.led{display:inline-flex;align-items:center;gap:7px;font-size:11px;letter-spacing:.14em;color:#7fe0a8}
.led i{width:7px;height:7px;border-radius:50%;background:#4fd18b;box-shadow:0 0 10px #4fd18b;animation:blink 2.4s infinite}
.led.warn{color:#f2d84b}.led.warn i{background:#f2d84b;box-shadow:0 0 10px #f2d84b}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.28}}

/* ---------- Seitenpanel ---------- */
#panel{
  position:absolute;top:16px;right:16px;width:264px;z-index:4;
  background:var(--glass);border:1px solid var(--line);border-radius:14px;
  backdrop-filter:blur(14px);box-shadow:0 18px 50px rgba(0,0,0,.6);
  overflow:hidden;
}
#panel .ph{padding:11px 14px 9px;border-bottom:1px solid var(--line);
  font-size:9.5px;letter-spacing:.18em;color:var(--ink3);text-transform:uppercase;
  display:flex;justify-content:space-between;align-items:center}
#panel .pb{padding:13px 14px 14px}
.tpi{display:flex;align-items:flex-end;gap:9px;margin-bottom:3px}
.tpi b{font-size:46px;line-height:.86;font-weight:700;letter-spacing:-.03em}
.tpi u{text-decoration:none;font-size:11px;color:var(--ink3);padding-bottom:6px}
.chip{display:inline-flex;align-items:center;gap:7px;margin:9px 0 14px;
  padding:4px 11px 4px 8px;border-radius:20px;font-size:11.5px;font-weight:600;
  border:1px solid;letter-spacing:.03em}
.chip i{width:9px;height:9px;border-radius:50%}
.rows{display:flex;flex-direction:column;gap:0}
.row{display:flex;justify-content:space-between;align-items:center;
  padding:7px 0;border-top:1px solid rgba(120,190,230,.09);font-size:12px}
.row span{color:var(--ink2)}
.row b{font-weight:600;letter-spacing:.01em}
.row em{font-style:normal;color:var(--ink3);font-size:10.5px;margin-left:5px}
.bar{height:3px;border-radius:2px;background:rgba(120,190,230,.13);margin-top:3px;overflow:hidden}
.bar i{display:block;height:100%;border-radius:2px;transition:width .35s ease}

/* ---------- Legende ---------- */
#legend{
  position:absolute;left:16px;bottom:16px;z-index:4;
  background:var(--glass);border:1px solid var(--line);border-radius:12px;
  backdrop-filter:blur(14px);padding:11px 13px;min-width:186px;
  box-shadow:0 14px 40px rgba(0,0,0,.55);
}
#legend h4{font-size:9.5px;letter-spacing:.17em;color:var(--ink3);
  text-transform:uppercase;font-weight:600;margin-bottom:9px}
.lg{display:flex;align-items:center;gap:9px;padding:3px 0;font-size:11.5px;color:var(--ink2)}
.lg i{width:16px;height:9px;border-radius:2px;flex:none}
.lg u{text-decoration:none;margin-left:auto;font-size:10px;color:var(--ink3)}
#legend .note{margin-top:9px;padding-top:8px;border-top:1px solid rgba(120,190,230,.1);
  font-size:9.5px;line-height:1.5;color:var(--ink3);max-width:210px}

/* ---------- Layer-Schalter ---------- */
#layers{position:absolute;left:16px;top:16px;z-index:4;display:flex;flex-direction:column;gap:7px}
.tgl{display:flex;align-items:center;gap:8px;cursor:pointer;user-select:none;
  background:var(--glass);border:1px solid var(--line);border-radius:9px;
  backdrop-filter:blur(12px);padding:7px 11px;font-size:11px;color:var(--ink2);
  letter-spacing:.05em;transition:.18s}
.tgl:hover{border-color:rgba(120,190,230,.4);color:var(--ink)}
.tgl i{width:8px;height:8px;border-radius:50%;background:var(--ink3);transition:.18s}
.tgl.on{color:var(--ink);border-color:rgba(87,182,224,.42)}
.tgl.on i{background:var(--accent);box-shadow:0 0 9px var(--accent)}

/* ---------- Zeitleiste ---------- */
footer{
  padding:11px 20px 13px;border-top:1px solid var(--line);
  background:linear-gradient(0deg,rgba(10,20,34,.94),rgba(5,7,13,.7));
  backdrop-filter:blur(8px);position:relative;z-index:5;
}
.tl{display:flex;align-items:center;gap:16px}
#play{
  width:38px;height:38px;flex:none;border-radius:50%;cursor:pointer;
  border:1px solid rgba(87,182,224,.42);background:rgba(87,182,224,.1);
  color:var(--accent);display:grid;place-items:center;transition:.18s;font-size:13px}
#play:hover{background:rgba(87,182,224,.22);box-shadow:0 0 18px rgba(87,182,224,.3)}
.tw{flex:1;position:relative}
.ticks{position:relative;height:15px;margin-bottom:1px}
.ticks u{position:absolute;top:0;transform:translateX(-50%);text-decoration:none;
  font-size:9.5px;color:var(--ink3);letter-spacing:.08em;white-space:nowrap}
.ticks u:before{content:"";position:absolute;left:50%;top:13px;width:1px;height:5px;
  background:var(--line)}
input[type=range]{
  -webkit-appearance:none;appearance:none;width:100%;height:22px;background:transparent;cursor:pointer;display:block}
input[type=range]::-webkit-slider-runnable-track{height:4px;border-radius:3px;
  background:linear-gradient(90deg,rgba(87,182,224,.55),rgba(87,182,224,.12))}
input[type=range]::-moz-range-track{height:4px;border-radius:3px;
  background:linear-gradient(90deg,rgba(87,182,224,.55),rgba(87,182,224,.12))}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:15px;height:15px;
  border-radius:50%;background:#eaf6ff;border:2px solid var(--accent);margin-top:-5.5px;
  box-shadow:0 0 14px rgba(87,182,224,.85)}
input[type=range]::-moz-range-thumb{width:15px;height:15px;border-radius:50%;
  background:#eaf6ff;border:2px solid var(--accent);box-shadow:0 0 14px rgba(87,182,224,.85)}
.tstamp{flex:none;text-align:right;min-width:200px}
.tstamp b{display:block;font-size:15px;font-weight:600;letter-spacing:.02em}
.tstamp u{text-decoration:none;font-size:10px;color:var(--ink3);letter-spacing:.12em;text-transform:uppercase}

/* ---------- Boot / Fehler ---------- */
#boot{position:fixed;inset:0;z-index:50;background:var(--bg);
  display:grid;place-items:center;transition:opacity .7s ease}
#boot.gone{opacity:0;pointer-events:none}
.bootbox{width:min(430px,86vw)}
.bootbox h1{font-size:21px;letter-spacing:.24em;font-weight:700;margin-bottom:5px}
.bootbox h1 i{font-style:normal;color:var(--accent)}
.bootbox p{font-size:10.5px;letter-spacing:.2em;color:var(--ink3);
  text-transform:uppercase;margin-bottom:22px}
#bootlog{font-size:11.5px;line-height:1.85;color:var(--ink2);min-height:112px}
#bootlog div:before{content:"› ";color:var(--accent)}
.pbar{height:2px;background:rgba(120,190,230,.15);border-radius:2px;margin-top:16px;overflow:hidden}
.pbar i{display:block;height:100%;width:0;background:var(--accent);
  box-shadow:0 0 10px var(--accent);transition:width .45s ease}
.peak{position:absolute;left:50%;top:16px;transform:translateX(-50%);z-index:4;cursor:pointer;
  display:flex;align-items:center;gap:10px;padding:8px 15px;border-radius:24px;
  background:var(--glass);border:1px solid var(--line);backdrop-filter:blur(12px);
  font-size:11.5px;color:var(--ink2);letter-spacing:.03em;transition:.18s;
  box-shadow:0 10px 30px rgba(0,0,0,.5)}
.peak:hover{border-color:rgba(87,182,224,.45);color:var(--ink)}
.peak b{font-weight:600}
.peak i{width:9px;height:9px;border-radius:50%;flex:none}
.peak s{text-decoration:none;color:var(--ink3);font-size:10px;
  border-left:1px solid var(--line);padding-left:10px}
.disc{position:absolute;left:50%;bottom:10px;transform:translateX(-50%);z-index:4;
  font-size:9.5px;color:var(--ink3);letter-spacing:.09em;text-align:center;
  background:rgba(5,7,13,.6);padding:4px 12px;border-radius:20px;
  border:1px solid rgba(120,190,230,.1);backdrop-filter:blur(6px)}

@media(max-width:900px){
  #panel{width:210px;top:10px;right:10px}
  .tpi b{font-size:36px}
  #legend{left:10px;bottom:10px;min-width:150px}
  #legend .note{display:none}
  #layers{top:10px;left:10px}
  .tstamp{min-width:130px}
  .stat:nth-child(n+4){display:none}
}
</style>
</head>
<body>

<div id="app">

  <header>
    <div class="brand">
      <b>TORNADO<i>//</i>DE</b>
      <span>Konvektions-Potenzial · Experimentell</span>
    </div>
    <div class="spacer"></div>
    <div class="stat"><u>Modell</u><b class="mono" id="sModel">ICON / Best-Match</b></div>
    <div class="stat"><u>Gitter</u><b class="mono" id="sGrid">–</b></div>
    <div class="stat"><u>Lauf</u><b class="mono" id="sRun">–</b></div>
    <div class="stat"><u>Status</u><b><span class="led" id="sLed"><i></i>VERBINDE</span></b></div>
  </header>

  <div id="stage">
    <canvas id="base"></canvas>
    <canvas id="wind"></canvas>
    <canvas id="fx"></canvas>

    <div id="layers">
      <div class="tgl on" data-l="risk"><i></i>Risikofeld</div>
      <div class="tgl on" data-l="wind"><i></i>Höhenströmung 500 hPa</div>
      <div class="tgl on" data-l="cells"><i></i>Hotspots</div>
      <div class="tgl on" data-l="scan"><i></i>Scan-Sweep</div>
    </div>

    <div id="panel">
      <div class="ph"><span id="pTitle">Deutschlandweites Maximum</span><span class="mono" id="pPos"></span></div>
      <div class="pb">
        <div class="tpi"><b class="mono" id="pTpi">–</b><u>/ 100 TPI</u></div>
        <div class="chip" id="pChip"><i></i><span>–</span></div>
        <div class="rows">
          <div class="row"><span>CAPE</span><b class="mono"><span id="pCape">–</span><em>J/kg</em></b></div>
          <div class="row"><span>Scherung 0–6 km</span><b class="mono"><span id="pShear">–</span><em>m/s</em></b></div>
          <div class="row"><span>CIN (Deckel)</span><b class="mono"><span id="pCin">–</span><em>J/kg</em></b></div>
          <div class="row"><span>LCL-Höhe</span><b class="mono"><span id="pLcl">–</span><em>m</em></b></div>
          <div class="row"><span>Höhenwind</span><b class="mono"><span id="pWind">–</span><em>km/h</em></b></div>
        </div>
        <div class="bar"><i id="pBar" style="width:0;background:var(--l1)"></i></div>
      </div>
    </div>

    <div id="legend">
      <h4>Tornado-Potenzial-Index</h4>
      <div class="lg"><i style="background:#d92f86"></i>Extrem<u>≥ 70</u></div>
      <div class="lg"><i style="background:#ee7a12"></i>Hoch<u>45–70</u></div>
      <div class="lg"><i style="background:#f2d84b"></i>Erhöht<u>25–45</u></div>
      <div class="lg"><i style="background:#57b6e0"></i>Gering<u>10–25</u></div>
      <div class="lg"><i style="background:rgba(120,190,230,.14)"></i>Minimal<u>&lt; 10</u></div>
      <div class="note">TPI = eigener Index aus CAPE, Tiefenscherung, CIN und LCL-Höhe.
        Keine Tornado-Wahrscheinlichkeit in Prozent — an 360 Tagen im Jahr liegt die
        nahe null.</div>
    </div>

    <div id="peak" class="peak" hidden></div>

    <div class="disc">Experimenteller Prototyp · <b>keine amtliche Warnung</b> · offizielle Warnlage: dwd.de · Daten: Open-Meteo / DWD ICON</div>
  </div>

  <footer>
    <div class="tl">
      <div id="play">▶</div>
      <div class="tw">
        <div class="ticks" id="ticks"></div>
        <input type="range" id="slider" min="0" max="48" step="0.5" value="0">
      </div>
      <div class="tstamp">
        <b class="mono" id="tLabel">–</b>
        <u id="tRel">Jetzt</u>
      </div>
    </div>
  </footer>
</div>

<div id="boot">
  <div class="bootbox">
    <h1>TORNADO<i>//</i>DE</h1>
    <p>Konvektions-Analyse Deutschland</p>
    <div id="bootlog"></div>
    <div class="pbar"><i id="bootbar"></i></div>
  </div>
</div>

<script>
"use strict";

/* ══════════════ Geometrie Deutschland (vereinfacht, offline eingebettet) ═════ */
